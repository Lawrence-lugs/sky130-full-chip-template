library (regfile) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 1.95;

  type ("addr") {
    base_type : array;
    data_type : bit;
    bit_width : 5;
    bit_from : 4;
    bit_to : 0;
  }
  type ("rdata") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("wdata") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("regfile") {
    area : 23618.680 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      capacitance : 0.0025;
    }
    pin("nrst") {
      direction : input;
      capacitance : 0.0025;
    }
    pin("we") {
      direction : input;
      capacitance : 0.0029;
    }
    bus("addr") {
      bus_type : addr;
      direction : input;
      capacitance : 0.0000;
    pin("addr[4]") {
      direction : input;
      capacitance : 0.0029;
    }
    pin("addr[3]") {
      direction : input;
      capacitance : 0.0034;
    }
    pin("addr[2]") {
      direction : input;
      capacitance : 0.0032;
    }
    pin("addr[1]") {
      direction : input;
      capacitance : 0.0033;
    }
    pin("addr[0]") {
      direction : input;
      capacitance : 0.0033;
    }
    }
    bus("rdata") {
      bus_type : rdata;
      direction : output;
      capacitance : 0.0000;
    pin("rdata[7]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("rdata[6]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("rdata[5]") {
      direction : output;
      capacitance : 0.0004;
    }
    pin("rdata[4]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("rdata[3]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("rdata[2]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("rdata[1]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("rdata[0]") {
      direction : output;
      capacitance : 0.0007;
    }
    }
    bus("wdata") {
      bus_type : wdata;
      direction : input;
      capacitance : 0.0000;
    pin("wdata[7]") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("wdata[6]") {
      direction : input;
      capacitance : 0.0029;
    }
    pin("wdata[5]") {
      direction : input;
      capacitance : 0.0048;
    }
    pin("wdata[4]") {
      direction : input;
      capacitance : 0.0030;
    }
    pin("wdata[3]") {
      direction : input;
      capacitance : 0.0034;
    }
    pin("wdata[2]") {
      direction : input;
      capacitance : 0.0023;
    }
    pin("wdata[1]") {
      direction : input;
      capacitance : 0.0031;
    }
    pin("wdata[0]") {
      direction : input;
      capacitance : 0.0042;
    }
    }
  }

}
